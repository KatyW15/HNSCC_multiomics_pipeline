/*
 * nf-core/sarek-only process overrides. Loaded after alpine.config.
 * TODO: copy the exact blocks from the cluster's curc_alpine.config.
 */

// Folder holding notes/sarek/manta_smtp_fix/sitecustomize.py on Alpine.
// TODO: set the real path.
def smtp_fix_dir = "/projects/${System.getenv('USER')}/HNSCC_analysis/scripts/manta_smtp_fix"

process {
  // pyflow (Manta + Strelka) hangs on the localhost SMTP probe on Alpine nodes since
  // 2026-10-22. Applied to ALL Manta/Strelka steps, not only the somatic ones: a new
  // batch also runs germline / tumor-only Manta and Strelka, which use pyflow too.
  withName: 'MANTA_.*|STRELKA_.*' {
    containerOptions = "--bind ${smtp_fix_dir} --env PYTHONPATH=${smtp_fix_dir}"
  }

  withName: 'MANTA_SOMATIC' {
    cpus           = 10      // TODO: confirm (batch 1 resume used 10 CPU / 16 GB / 72 h)
    memory         = 16.GB
    time           = 72.h
    maxRetries     = 1
    clusterOptions = '--account=amc-general --qos=cpu-long'
    // TODO: add minEdgeObservations here if the manta_edge_test shows it's worth it
  }

  withName: 'FREEBAYES' {
    memory = { 12.GB * task.attempt }
    time   = 23.h
  }
}
