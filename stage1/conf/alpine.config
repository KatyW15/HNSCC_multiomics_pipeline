/*
 * Shared Slurm/Singularity settings for all three Stage 1 pipelines on Alpine.
 *
 * TODO: replace this file's body with the validated
 *   /projects/$USER/HNSCC_analysis/scripts/curc_alpine.config
 * from the cluster (older copies: conf/slurm.config, HNSCC_pipeline_build/nextflow_alpine.config).
 * Move any sarek-only blocks (MANTA_*, STRELKA_*, FREEBAYES) into conf/sarek.config.
 */
params {
  config_profile_description = 'CURC alpine cluster profile'
  config_profile_contact     = 'Kaitlyn Walsh'
}

singularity {
  enabled    = true
  autoMounts = true
}

process {
  executor      = 'slurm'
  queue         = 'acpu'
  errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
  maxRetries    = 3
  clusterOptions = '--account=amc-general --qos=cpu-normal'

  // NOTE: process_high goes to cpu-long here, so in rnaseq/smrnaseq the big aligner
  // jobs (STAR_ALIGN, index builds) count against the 200-job cpu-long quota.
  withLabel:process_long {
    clusterOptions = '--account=amc-general --qos=cpu-long'
    time = 96.h
  }
  withLabel:process_medium {
    clusterOptions = '--account=amc-general --qos=cpu-normal'
    time = 23.h
  }
  withLabel:process_high {
    clusterOptions = '--account=amc-general --qos=cpu-long'
    time = 96.h
  }

  // nf-core pipelines from template 3.0 on cap resources with resourceLimits;
  // the old params.max_* are ignored by sarek 3.9 / rnaseq 3.26.
  resourceLimits = [ cpus: 48, memory: 240.GB, time: 96.h ]
}

executor {
  name            = 'slurm'
  // Max jobs this ONE Nextflow head keeps queued/running. Three heads at once can
  // reach 3x this. TODO: set per pipeline in the launcher to respect Slurm quotas.
  queueSize       = 150
  perJobMemLimit  = true
  submitRateLimit = '200 / 60 min'
  killBatchSize   = 50
}
