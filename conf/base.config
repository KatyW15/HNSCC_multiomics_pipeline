// Default per-process resource requests. Override in conf/slurm.config or
// process-label blocks as real resource needs become clear during implementation.

process {
    cpus   = { 2    * task.attempt }
    memory = { 8.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = { 2   * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 6   * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 12  * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
}
