// Slurm + Singularity execution profile.
/*
 * -------------------------------------------------------------
 *  Nextflow nf-core config file for the University of Colorado
 *  Research Computing alpine HPC cluster
 * -------------------------------------------------------------
 * Defines SLURM process executor and singularity settings.
 * Katy Walsh Aug 2026
 */


process {
    executor    = 'slurm'
    queue       = 'acpu'
    clusterOptions = '--account=amc-general --qos=cpu-normal'
    errorStrategy = { task.attempt <= 3 ? "retry" : "finish" }
    maxRetries = 3

    // cpu-normal caps jobs at 24 h. process_high retries in conf/base.config
    // (16 h x attempt) go past that, so they run on cpu-long, matching the
    // Stage 1 routing in stage1/conf/alpine.config.
    withLabel: process_high {
        clusterOptions = '--account=amc-general --qos=cpu-long'
    }
}


executor{
    name = 'slurm'
    queueSize = 150
    perJobMemLimit = true
    submitRateLimit = '200 / 60 min'   // same as Stage 1 (stage1/conf/alpine.config)
}

params {
  max_memory = 240.GB
  max_cpus = 48
  max_time = 24.h
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir  = "/projects/${System.getenv('USER')}/container_cache"
}

env {
  SINGULARITY_TMPDIR = "/scratch/alpine/${System.getenv('USER')}/singularity/tmp"
  SINGULARITY_CACHEDIR = "/scratch/alpine/${System.getenv('USER')}/singularity/cache"
}

docker {
    enabled = false
}
