// Minimal-resource profile for CI: runs the pipeline structure against a
// small subsampled dataset so structural changes are validated on every
// push/PR without needing real patient data or HPC access.
//
// TODO once subworkflows are implemented: point `params.samplesheet` etc. at
// small test fixtures checked into (or fetched by) this repo's test assets.

params {
    samplesheet     = "${projectDir}/assets/samplesheet_template.csv"
    outdir          = './results-test'
}

process {
    executor = 'local'
    cpus     = 2
    memory   = 6.GB
    time     = 1.h
}

singularity {
    enabled    = true
    autoMounts = true
}
