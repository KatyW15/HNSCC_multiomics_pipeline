manifest {
    name            = 'HNSCC_multiomics_pipeline'
    author          = 'Wang Lab'
    homePage        = 'https://github.com/KatyW15/HNSCC_multiomics_pipeline'
    description     = 'Multi-omics circRNA/HPV profiling pipeline for paired tumor/normal HNSCC samples'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.1.0-dev'
}

params {
    // Inputs
    samplesheet      = null
    rnaseq_results   = null   // Stage 1a output dir (nf-core/rnaseq v3.26.0)
    sarek_results     = null  // Stage 1b output dir (nf-core/sarek v3.9.0)

    // Reference data — all staged externally (see download_references.sh),
    // not committed to this repo. Point these at your HPC reference dir,
    // e.g. /projects/$USER/HNSCC_analysis/reference_genomes/
    fasta            = null   // hg38/GRCh38.primary_assembly.genome.fa
    gtf              = null   // gencode/gencode.v50.annotation.gtf
    hpv_panel_fasta  = null   // hpv/hpv_panel.fa

    // circRNA arm (CIRCRNASEQ) — see pipeline_architecture.md §3 + open items #1, #20-24
    circrna_annotation           = null   // pinned circAtlas hg38 release (required for the circRNA arm; open item #16)
    circrna_tools                = 'circexplorer2,ciriquant,find_circ'  // detection ensemble; --circrna_tools toggle
    star_index                   = null   // prebuilt; else built from fasta/gtf
    bwa_index                    = null   // prebuilt; else built
    bowtie2_index                = null   // prebuilt; else built
    ciriquant_index              = null   // prebuilt CIRIquant ref bundle; else built
    star_sjdb_overhang           = 149
    star_chimeric_args           = '--chimSegmentMin 12 --chimJunctionOverhangMin 12 --chimScoreMin 1 --chimScoreDropMax 20 --chimScoreSeparation 10 --chimOutType Junctions'  // open item #23 — keep in sync with Stage 1a
    trimgalore_args              = ''
    circrna_bsj_min_reads        = 2      // decision 6
    circrna_min_tools            = 2      // decision 7 — restricts only the quantified DE matrix
    circrna_bsj_merge_slop       = 5      // decision 8 — bp margin for cross-tool BSJ matching
    circrna_deseq2_sizefactors   = 'poscounts'  // open item #20 — placeholder
    circrna_min_expr_reads       = 2      // decision 19 — low-count prefilter
    circrna_min_expr_samples_frac = 0.25  // decision 19

    // Output
    outdir           = './results'

    // Misc
    tracedir         = "${params.outdir}/pipeline_info"
    validate_params  = true
}

// Load base.config by default for all pipeline runs
includeConfig 'conf/base.config'

profiles {
    slurm {
        includeConfig 'conf/slurm.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
}

// Execution reports — always on, land under outdir/pipeline_info per run
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag_${trace_timestamp}.html"
}
